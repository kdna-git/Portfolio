<UserControl
    x:Class="Portfolio.Charts.Views.SparklineView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:vm="using:Portfolio.Charts.ViewModels"
    x:DataType="vm:SparklineViewModel"
    MinWidth="56"
    MinHeight="22">

    <!--  No axes, no legend, no tooltip: at this size they would be the whole figure.  -->
    <lvc:CartesianChart
        IsHitTestVisible="False"
        IsVisible="{Binding !IsEmpty}"
        LegendPosition="Hidden"
        Series="{Binding Series}"
        TooltipPosition="Hidden"
        XAxes="{Binding XAxes}"
        YAxes="{Binding YAxes}" />
</UserControl>
