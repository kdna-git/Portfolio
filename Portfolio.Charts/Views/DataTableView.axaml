<UserControl
    x:Class="Portfolio.Charts.Views.DataTableView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Portfolio.Charts.Controls"
    xmlns:conv="using:Portfolio.Charts.Converters"
    xmlns:vm="using:Portfolio.Charts.ViewModels"
    x:DataType="vm:DataTableViewModel">

    <!--
        Columns are data, so the grid is built from an ItemsControl rather than fixed in markup. The
        whole table scrolls sideways below its natural width: on a phone a six-column matrix has to
        be pannable, and squeezing it instead would make every number unreadable.

        Every row is laid out on its own, so the value cells go in a SharedColumnsGrid: column n is
        as wide as the widest cell in column n across the heading and all the rows, and the size
        scope here keeps that sharing to this one table.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid
            MinWidth="{Binding MinWidth}"
            Grid.IsSharedSizeScope="True"
            RowDefinitions="Auto,*">

            <!--
                Heading row: each cell sorts its column, and it is laid out exactly like a data row —
                label in the star column, values in the shared columns, and the same right inset as
                a row's padding — so the headings sit over the numbers they name.
            -->
            <Grid
                Grid.Row="0"
                Margin="0,0,6,0"
                ColumnDefinitions="*,Auto">
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Classes="columnHeader leading"
                    Command="{Binding SortCommand}"
                    CommandParameter="{Binding LabelColumn.Key}"
                    Content="{Binding LabelColumn.Header}"
                    IsVisible="{Binding LabelColumn, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <ItemsControl Grid.Column="1" ItemsSource="{Binding ValueColumns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:SharedColumnsGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TableColumn">
                            <!--  Stretched so the right-aligned heading ends where the column does.  -->
                            <Button
                                MinWidth="72"
                                Margin="6,0"
                                Padding="0,4"
                                HorizontalAlignment="Stretch"
                                Classes="columnHeader"
                                Command="{Binding $parent[ItemsControl].((vm:DataTableViewModel)DataContext).SortCommand}"
                                CommandParameter="{Binding Key}"
                                Content="{Binding Header}"
                                ToolTip.Tip="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DisplayRow">
                        <Border Classes="tableRow" Classes.pinned="{Binding IsPinned}">
                            <Grid ColumnDefinitions="*,Auto">
                                <!--  Label cell, with the swatch that ties the row to its slice.  -->
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Border
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={x:Static conv:ChartConverters.HexToBrush}}"
                                        CornerRadius="2"
                                        IsVisible="{Binding Color, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="{Binding IsPinned, Converter={x:Static conv:ChartConverters.PinnedToWeight}}"
                                            Foreground="{DynamicResource ChartPrimaryInkBrush}"
                                            Text="{Binding Label}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource ChartMutedInkBrush}"
                                            IsVisible="{Binding Sublabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Text="{Binding Sublabel}" />
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:SharedColumnsGrid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DisplayCell">
                                            <!--  Text right-aligned too: a short value would sit at the left of its minimum width.  -->
                                            <TextBlock
                                                MinWidth="72"
                                                Margin="6,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Classes="metricValue"
                                                Classes.negative="{Binding IsNegative}"
                                                Classes.positive="{Binding IsPositive}"
                                                FontSize="12"
                                                Text="{Binding Text}"
                                                TextAlignment="Right" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Grid.Row="1"
                Margin="0,16"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource ChartMutedInkBrush}"
                IsVisible="{Binding IsEmpty}"
                Text="Nothing to show yet" />
        </Grid>
    </ScrollViewer>
</UserControl>
