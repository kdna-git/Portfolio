<UserControl
    x:Class="Portfolio.Features.Shared.ConfirmationOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Portfolio.Features.Shared"
    x:DataType="shared:DeleteConfirmation"
    IsVisible="{Binding IsVisible}">

    <!--  Scrim plus a centred card, so the question cannot be missed or scrolled past.  -->
    <Border Background="#73000000">
        <Border
            MaxWidth="420"
            Margin="16"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #40000000"
            CornerRadius="{DynamicResource AppCardRadius}">
            <StackPanel Spacing="14">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AppInkBrush}"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />

                <!--  Spells out what else goes, because these deletes cascade.  -->
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource AppInkSecondaryBrush}"
                    IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap" />

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Classes="secondary"
                        Command="{Binding CancelCommand}"
                        Content="Keep it" />
                    <Button
                        Classes="danger"
                        Command="{Binding ConfirmCommand}"
                        Content="Delete" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
